# Raw data is git-ignored; it regenerates from the manifest (data/manifest.md).
data/raw/
data/interim/
data/processed/

# Large binary outputs (tracked via manifest/checksums, not git)
*.pkl
*.joblib
*.bin
# ...but DO ship the trained per-drug models so the demo runs on a fresh clone (~13 MB)
!results/models/**

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.venv/
env/

# OS / editor
.DS_Store
.vscode/
.idea/

# Keep directory structure for ignored dirs
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!results/models/.gitkeep

# local secrets — API keys for the AI narrative layer
.env
